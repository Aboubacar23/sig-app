{% extends 'base.html.twig' %}

{% block title %}Client index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">

                                <div class="row">
                                    <div class="col-md-3">
                                        <h4 class="card-title">Liste des clients</h4>
                                    </div>
                                    <div class="col-md-9 text-end">
                                        {# <a href="#" class="btn btn-secondary text-white">Nombres : {{ entrepots | length}}</a>
                                    <a href="{{path('app_entrepot_new')}}" class="btn btn-primary btn-sm"><i class="mdi mdi-plus-circle icon-table"></i></a>#}
                                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                            <i class="mdi mdi-plus-box icon-table"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true">
                                    <table class="table table-striped mb-0" id="dataTable">
                                        <thead>
                                        <tr>
                                            <th scope="col">N°</th>
                                            <th scope="col">Nom</th>
                                            <th scope="col">Prenom</th>
                                            <th scope="col">Code client</th>
                                            <th scope="col">Telephone</th>
                                            <th scope="col">Adresse</th>
                                            <th scope="col">Contact</th>
                                            <th scope="col">Etat</th>
                                            <th class="text-center" width="200"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                            {% set i = 0 %}
                                            {% for client in clients %}
                                                {% set i = i + 1 %}
                                                <tr>
                                                    <td>{{ i }}</td>
                                                    <td>{{ client.nom }}</td>
                                                    <td>{{ client.prenom }}</td>
                                                    <td>{{ client.codeClient }}</td>
                                                    <td>{{ client.telephone }}</td>
                                                    <td>{{ client.adresse }}</td>
                                                    <td>{{ client.contact }}</td>
                                                    <td>
                                                        {% if client.etat == true %}
                                                            <span class="btn bg-success btn-sm text-white">{{ client.etat ? 'Ouvert' : 'Bloqué' }}</span>
                                                        {% else %}
                                                            <span class="btn bg-danger btn-sm text-white">{{ client.etat ? 'Ouvert' : 'Bloqué' }}</span>
                                                        {% endif %}
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="{{ path('app_client_show', {'id': client.id}) }}" class="btn btn-info text-white btn-sm">Détails <i class="mdi mdi-eye p-1"></i></a>
                                                        <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="btn btn-primary text-white btn-sm">Modifier<i class="mdi mdi-pencil-box-outline p-1"></i></a>
                                                        <a href="{{ path('app_client_compte', {'id': client.id}) }}" class="btn btn-success btn-sm text-white">Compte<i class="mdi mdi-folder p-1 text-white"></i></a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    {% if dernier == null %}
        {% set val = 1 %}
    {% else %}
        {% set val = dernier.id + 1 %}
    {% endif %}

    {% set dateJour = "now"|date("Y") %}
    {% set numC = 'SIGCC' ~ dateJour~''~val %}

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Ajouter</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            {{ form_start(form) }}
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">{{ form_row(form.code_client, { attr : { value: numC }}) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.nom) }}</div>
                    <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.adresse) }}</div>
                    <div class="col-md-6">{{ form_row(form.contact) }}</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary text-white" data-bs-dismiss="modal"><i class="mdi mdi-close"></i></button>
                <button type="submit" class="btn btn-primary"><i class="mdi mdi-content-save"></i></button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
