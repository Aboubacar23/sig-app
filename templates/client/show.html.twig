{% extends 'base.html.twig' %}

{% block title %}Client{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Détails Client : {{ client.codeClient }}</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            {% if client.etat == true %}
                                <a href="{{ path('app_client_etat', {'id': client.id}) }}" class="btn  btn-danger btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Fermé <i class="mdi mdi-close"></i></a>
                            {% else %}
                                <a href="{{ path('app_client_etat', {'id': client.id}) }}" class="btn  btn-success btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Ouvert <i class="mdi mdi-close"></i></a>
                            {% endif %}
                            <a href="{{path('app_client_edit', {'id' : client.id })}}" class="btn btn-warning btn-sm  text-white">Modifier <i class="mdi mdi-pencil-box-outline"></i></a>
                            <a href="{{path('app_client_delete', {'id' : client.id })}}" class="btn btn-danger btn-sm text-white" onclick="return confirm('Voulez-vous confirmer ?')">Supprimer <i class="mdi mdi-delete"></i></a>
                            <a href="{{path('app_client_index')}}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>Nom</th>
                                    <td>{{ client.nom }}</td>
                                    <th>Prenom</th>
                                    <td>{{ client.prenom }}</td>
                                    <th>Email</th>
                                    <td>{{ client.email }}</td>
                                </tr>
                                <tr>
                                    <th>Telephone</th>
                                    <td>{{ client.telephone }}</td>
                                    <th>Contact</th>
                                    <td>{{ client.contact }}</td>
                                    <th>Adresse</th>
                                    <td>{{ client.adresse }}</td>
                                </tr>
                                <tr>
                                    <th>Etat</th>
                                    <td>
                                        {% if client.etat == true %}
                                            <span class="btn bg-success btn-sm text-white">{{ client.etat ? 'Activer' : 'Désactiver' }}</span>
                                        {% else %}
                                            <span class="btn bg-danger btn-sm text-white">{{ client.etat ? 'Activer' : 'Désactiver' }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
