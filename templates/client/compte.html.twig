{% extends 'base.html.twig' %}

{% block title %}CommandeClient index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Compte Client : {{ client.codeClient }}</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            <a href="{{path('app_client_facture', {'id' : client.id })}}" class="btn btn-primary btn-sm  text-white">Facture <i class="mdi mdi-file p-1"></i></a>
                            <a href="{{path('app_client_index')}}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th colspan="8" class="text-center">Commande Client</th>
                                </tr>
                                <tr>
                                    <th>N°</th>
                                    <th>N° commande</th>
                                    <th>N° reference</th>
                                    <th>Date commande</th>
                                    <th>Date Paiement</th>
                                    <th>Type commande</th>
                                    <th>Etat Commande</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            {% set i = 0 %}
                            {% for commande_client in commandes %}
                                {% if commande_client.client.id == client.id %}
                                    {% set i = i + 1 %}
                                    <tr>
                                        <td>{{ i }}</td>
                                        <td>{{ commande_client.codeCommande }}</td>
                                        <td>{{ commande_client.numeroReference }}</td>
                                        <td>{{ commande_client.dateCommande ? commande_client.dateCommande|date('Y-m-d') : '' }}</td>
                                        <td>{{ commande_client.paiementDate ? commande_client.paiementDate|date('Y-m-d') : '' }}</td>
                                        <td>{{ commande_client.typeCommande }}</td>
                                        <td>
                                            {% if commande_client.etat == true %}
                                                <span class="btn bg-success btn-sm text-white">{{ commande_client.etat ? 'Valider' : 'INvalider' }}</span>
                                            {% else %}
                                                <span class="btn bg-danger btn-sm text-white">{{ commande_client.etat ? 'Valider' : 'INvalider' }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <a href="{{ path('app_commande_client_print', {'id': commande_client.id}) }}" class="btn btn-info btn-sm text-white" target="_blank">Imprimer <i class="mdi mdi-printer p-1"></i></a>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% else %}
                                <tr>
                                    <td colspan="11">La table est vide </td>
                                </tr>
                            {% endfor %}

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
