  {% extends 'base_print.html.twig' %}

{% block title %}facture index{% endblock %}

{% block body %}
    <header class="clearfix">
        <div id="logo">
            <img src="{{ absolute_url(asset('images/images/logo.jpeg')) }}" >
        </div>

        <h1>Bon de livraison <br>{{ livraison.numLivraison }}</h1>
        <div id="company" class="clearfix">
            <div>Sacko Investment Group - SARL</div>
            <div>Dixinn face a la commune immeuble dem 4 em étage
                ,<br /> Conakry République de Guinée</div>
            <div>+224 628 44 67 40</div>
            <div><a href="#">Sackomory547@gmail.com</a></div>
        </div>
        <div id="project">
            <div><span>N° Commande : </span> <small>{{ livraison.facture.commande.codeCommande }}</small></div>
            <div><span>Date Commande :</span> <small>{{ livraison.facture.commande.dateCommande ? livraison.facture.commande.dateCommande|date('d-m-Y') : '' }}</small></div>
            <div><span>Date Livraison :</span> <small>{{ livraison.dateLivraison ? livraison.dateLivraison|date('d-m-Y') : '' }}</small></div>
            <div><span>Adresse Livraison :</span> <small>{{ livraison.adresse}}</small></div>
        </div>
    </header>
    <hr>
    <header class="clearfix">
        <div id="project">
            <div><span>Client : </span> <small>{{ livraison.facture.commande.client.nom }} {{ livraison.facture.commande.client.prenom }}</small></div>
            <div><span>Tél :</span> <small>{{ livraison.facture.commande.client.telephone }}</small></div>
            <div><span>Email :</span> <small>{{ livraison.facture.commande.client.email }}</small></div>
            <div><span>Adresse :</span> <small>{{ livraison.facture.commande.client.adresse }}</small></div>
        </div>
    </header>
    <hr>
    <main>
        <table>
            <thead>
            <tr>
                <th class="service" colspan="10"></th>
            </tr>
            <tr>
                <th style="width: 5px!important;">N°</th>
                <th style="width: 70px!important;">Produit</th>
                <th style="width: 50px!important;">Qte</th>
                <th class="tab_prix">Prix Unitaire (GNF)</th>
                <th class="tab_prix">Remise (GNF)</th>
                <th class="tab_q">TVA (%)</th>
                <th class="tab_prix" style="text-align: left!important;">Total HT (GNF)</th>
                <th class="tab_prix" style="text-align: right!important;">Total TTC (GNF)</th>
            </tr>
            </thead>
            <tbody>
            {%  set montantTotalTTC = 0 %}
            {%  set montantTotalHT = 0 %}
            {%  set montantHT = 0 %}
            {%  set montantTTC = 0 %}
            {%  set montantTVA = 0 %}
            {%  set i = 0 %}
            {%  set count = 0 %}

            {% for l in lcommandes %}
                {% if l.numCommande == livraison.facture.commande.codeCommande %}
                    {%  set i = i + 1 %}
                    {%  set count = count + 1 %}
                    {%  set montantHT = l.quantite * l.produit.prixVente %}
                    {%  set montantTVA = montantHT * (l.tva/100) %}
                    {%  set montantTTC = montantHT + montantTVA - l.remise %}
                    {%  set montantTotalTTC = montantTotalTTC + montantTTC %}
                    {%  set montantTotalHT = montantTotalHT + montantHT %}

                    <tr class="th">
                        <td width="10px">{{ i }}</td>
                        <td>{{l.produit.libelle}}</td>
                        <td class="tab_right">{{l.quantite}}</td>
                        <td class="tab_right">{{l.produit.prixVente | number_format(2) }} GNF</td>
                        <td class="tab_right">{{l.remise| number_format(2)}} GNF</td>
                        <td class="tab_right">{{l.tva}} %</td>
                        <td class="tab_right" style="text-align: left!important;">{{ montantHT | number_format(2) }} GNF</td>
                        <td class="tab_right" style="text-align: right!important;">{{ montantTTC | number_format(2) }} GNF</td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
        <br>
        <br>
        <br>
        <br>
        <div >
            <span>Signature</span>
        </div>
    </main>
{% endblock %}
