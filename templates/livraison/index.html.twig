{% extends 'base.html.twig' %}

{% block title %}Livraison index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">

                                <div class="row">
                                    <div class="col-md-3">
                                        <h4 class="card-title">Liste des livraisons</h4>
                                    </div>
                                    <div class="col-md-9 text-end">
                                        <a href="{{ path('app_livraison_new') }}" class="btn btn-primary btn-sm">Ajouter <i class="mdi mdi-plus-box p-1"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true">
                                    <table class="table table-striped mb-0" id="dataTable">
                                        <thead>
                                        <tr>
                                            <th scope="col">N°</th>
                                            <th>Date livraison</th>
                                            <th>livraison</th>
                                            <th>Client</th>
                                            <th>Facture</th>
                                            <th>Commande</th>
                                            <th>Date Commande</th>
                                            <th>Adresse</th>
                                            <th class="text-center" width="200"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set i  = 0 %}
                                        {% for livraison in livraisons %}
                                            {% set i  = i + 1 %}
                                            <tr>
                                                <td>{{ i }}</td>
                                                <td>{{ livraison.dateLivraison ? livraison.dateLivraison|date('d-m-Y') : '' }}</td>
                                                <td>{{ livraison.numLivraison }}</td>
                                                <td>{{ livraison.facture.commande.client.nom }} {{ livraison.facture.commande.client.prenom }}</td>
                                                <td>{{ livraison.facture }}</td>
                                                <td>{{ livraison.facture.commande }}</td>
                                                <td>{{ livraison.facture.commande.dateCommande ? livraison.facture.commande.dateCommande|date('d-m-Y') : '' }}</td>
                                                <td>{{ livraison.adresse }}</td>
                                                <td class="text-center">
                                                    <a href="{{ path('app_livraison_show', {'id': livraison.id}) }}" class="btn btn-info text-white btn-sm">Détails <i class="mdi mdi-eye p-1"></i></a>
                                                    <a href="{{ path('app_livraison_edit', {'id': livraison.id}) }}" class="btn btn-primary text-white btn-sm">Modifier<i class="mdi mdi-pencil-box-outline p-1"></i></a>
                                                    <a href="{{ path('app_print_livraison', {'id': livraison.id}) }}" class="btn btn-sm btn-secondary text-white" target="_blank">Imprimer <i class="mdi mdi-printer p-1"></i></a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
