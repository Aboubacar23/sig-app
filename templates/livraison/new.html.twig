{% extends 'base.html.twig' %}

{% block title %}New Livraison{% endblock %}

{% block body %}

{% if dernier == null %}
    {% set val = 1 %}
{% else %}
    {% set val = dernier.id + 1 %}
{% endif %}
{% set dateJour = "now"|date("Ym") %}
{% set numFour = 'L' ~ dateJour ~ val %}

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                {{ form_start(form) }}
                <div class="card-header">
                    <h4 class="card-title">Ajouter la Livraison</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-1">
                        <div class="col-md-6">{{ form_row(form.num_livraison, {attr : { value: numFour }})}}</div>
                        <div class="col-md-6">{{ form_row(form.facture)}}</div>
                    </div>
                    <div class="row mb-1">
                        <div class="col-md-6">{{ form_row(form.date_livraison)}}</div>
                        <div class="col-md-6">{{ form_row(form.adresse)}}</div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <div class="d-flex">
                        <button type="submit" class="btn btn-primary btn-sm ">Enregistrer<i class="mdi mdi-content-save p-1"></i></button>
                        <a href="#" onclick="history.back()" class="btn btn-secondary btn-sm ms-auto text-white">Retour<i class="mdi mdi-reply p-1"></i></a>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
