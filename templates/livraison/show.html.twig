{% extends 'base.html.twig' %}

{% block title %}Livraison{% endblock %}

{% block body %}

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Détails Livraisons : {{  livraison.numLivraison }}</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            <a href="{{path('app_print_livraison', {'id': livraison.id})}}" class="m-2 btn btn-info btn-sm text-white" target="_blank">Imprimer <i class="mdi mdi-printer p-1"></i></a>

                            <a href="{{path('app_livraison_edit', {'id' : livraison.id })}}" class="btn btn-warning btn-sm  text-white m-2">Modifier <i class="mdi mdi-pencil-box-outline"></i></a>
                            <a href="{{path('app_livraison_delete', {'id' : livraison.id })}}" class="btn btn-danger btn-sm text-white m-2" onclick="return confirm('Voulez-vous confirmer ?')">Supprimer <i class="mdi mdi-delete"></i></a>
                            <a href="{{path('app_livraison_index')}}" class="btn btn-secondary btn-sm text-white m-2">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}
                        <table class="table table-striped m-2">
                            <tbody>
                                <tr>
                                    <th>Num livraison</th>
                                    <td>{{ livraison.numLivraison }}</td>
                                    <th>Num Commande</th>
                                    <td>{{ livraison.facture.commande }}</td>
                                </tr>
                                <tr>
                                    <th>Num Facture</th>
                                    <td>{{ livraison.facture }}</td>
                                    <th>Client</th>
                                    <td>{{ livraison.facture.commande.client.nom }} {{ livraison.facture.commande.client.prenom }}</td>
                                </tr>
                                <tr>
                                    <th>Date livraison</th>
                                    <td>{{ livraison.dateLivraison ? livraison.dateLivraison|date('Y-m-d') : '' }}</td>
                                    <th>Adresse</th>
                                    <td>{{ livraison.adresse }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
