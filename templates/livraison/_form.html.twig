
{{ form_start(form) }}
<div class="card-header">
    <h4 class="card-title">Modifier la Livraison</h4>
</div>
<div class="card-body">
    <div class="row mb-1">
        <div class="col-md-4">{{ form_row(form.num_livraison)}}</div>
        <div class="col-md-4">{{ form_row(form.date_livraison)}}</div>
        <div class="col-md-4">{{ form_row(form.adresse)}}</div>
    </div>
</div>
<div class="card-footer text-end">
    <div class="d-flex">
        <button type="submit" class="btn btn-primary btn-sm ">Modifier<i class="mdi mdi-content-save p-1"></i></button>
        <a href="#" onclick="history.back()" class="btn btn-secondary btn-sm ms-auto text-white">Retour<i class="mdi mdi-reply p-1"></i></a>
    </div>
</div>
{{ form_end(form) }}