{% extends 'base.html.twig' %}

{% block title %}New Versement{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header pd-10 text-right">
                    <div class="row">
                        <div class="col-md-12 text-left">
                            <a href="#{}" class="btn btn-info btn-sm text-white">Montant à payer <i class="fa fa-money p-1"></i> {{ reste | number_format(2) }} GNF</a>
                            <a href="{{ path('app_facture_client_index') }}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply p-1"></i></a>
                        </div>
                    </div>
                </div>
                   {{ form_start(form) }}
                        <div class="card-body">
                            {% for flash_message in app.session.flashbag.get('error') %}
                                <div class="container alert alert-danger" role="alert">
                                    {{ flash_message }}
                                </div>
                                {% endfor %}

                            <div class="row mb-2">
                                <div class="col-md-4">{{ form_row(form.montant)}}</div>
                                <div class="col-md-4">{{ form_row(form.banque)}}</div>
                                <div class="col-md-4">{{ form_row(form.type_reglement)}}</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-4">{{ form_row(form.delegue)}}</div>
                                <div class="col-md-4">{{ form_row(form.emetteur_cheque)}}</div>
                                <div class="col-md-4">{{ form_row(form.date_versement)}}</div>
                            </div>
                        </div>
                        <div class="card-footer mb-2">
                            <div class="col-md-4">
                                <button class="btn btn-primary btn-sm">{{ button_label|default('Paiement') }} <i class="mdi mdi-content-save p-1"></i></button>
                            </div>
                        </div>
                    {{ form_end(form) }}
            </div>
        </div>
    </div>
</div> 
{% endblock %}
 