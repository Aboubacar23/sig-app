{% extends 'base.html.twig' %}

{% block title %}FactureClient{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-3">
                                <h4 class="card-title">Détails Facture : {{  facture_client.numeroFacture }}</h4>
                            </div>
                            <div class="col-md-9 text-end">
                                <a href="{{path('app_print_facture', {'id': facture_client.id})}}" class="m-2 btn btn-info btn-sm text-white" target="_blank">Imprimer <i class="mdi mdi-printer p-1"></i></a>
                                {% if facture_client.paiement == true %}
                                    <a href="{{ path('app_facture_client_paiement', {'id': facture_client.id}) }}" class="btn  btn-danger btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Non payer <i class="mdi mdi-close"></i></a>
                                {% else %}
                                    <a href="{{ path('app_facture_client_paiement', {'id': facture_client.id}) }}" class="btn  btn-success btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Payer <i class="mdi mdi-close"></i></a>
                                {% endif %}
                                <a href="{{path('app_facture_client_edit', {'id' : facture_client.id })}}" class="btn btn-warning btn-sm  text-white m-2">Modifier <i class="mdi mdi-pencil-box-outline"></i></a>
                                <a href="{{path('app_facture_client_delete', {'id' : facture_client.id })}}" class="btn btn-danger btn-sm text-white m-2" onclick="return confirm('Voulez-vous confirmer ?')">Supprimer <i class="mdi mdi-delete"></i></a>
                                <a href="{{ path('facture_paiement', {'id': facture_client.id}) }}" onclick="confirm('Voulez-vous confirmer !')" class="btn btn-success btn-sm text-white m-2">Money<i class="mdi mdi-currency-usd p-1"></i></a>
                                <a href="{{path('app_facture_client_index')}}" class="btn btn-secondary btn-sm text-white m-2">Retour <i class="mdi mdi-reply"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            {% for message in app.flashes('success') %}
                                <div class="alert alert-success">
                                    {{ message }}
                                </div>
                            {% endfor %}
                            {% for message in app.flashes('error') %}
                                <div class="alert alert-danger">
                                    {{ message }}
                                </div>
                            {% endfor %}
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <th>Numero facture</th>
                                        <td>{{ facture_client.numeroFacture }}</td>
                                        <th>Date facturation</th>
                                        <td>{{ facture_client.dateFacturation ? facture_client.dateFacturation|date('Y-m-d') : '' }}</td>
                                        <th>Condition paiement</th>
                                        <td>{{ facture_client.conditionPaiement }}</td>
                                    </tr>
                                    <tr>
                                        <th>Etat</th>
                                        <td>
                                            {% if facture_client.paiement == true %}
                                                <span class="btn btn-success btn-sm text-white">{{ facture_client.paiement ? 'Payer' : 'Non Payer' }}</span>
                                            {% elseif facture_client.paiement == false %}
                                                <span class="btn btn-danger btn-sm text-white">{{ facture_client.paiement ? 'Payer' : 'Non Payer' }}</span>
                                            {% endif %}
                                        </td>
                                        <th>Mode paiement</th>
                                        <td>{{ facture_client.modePaiement }}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-striped m-2">
                                <thead>
                                    <tr>
                                        <td>N°</td>
                                        <td>Images</td>
                                        <td>Produit</td>
                                        <td >Qte</td>
                                        <td>Prix (GNF)</td>
                                        <td>Remise (GNF)</td>
                                        <td>TVA</td>
                                        <td class="#">Total HT (GNF)</td>
                                        <td class="text-right">Total TTC (GNF)</td>
                                    </tr>
                                </thead>
                                <tbody>
                                {%  set montantTotalTTC = 0 %}
                                {%  set montantHT = 0 %}
                                {%  set montantTTC = 0 %}
                                {%  set montantTVA = 0 %}
                                {%  set montantNet = 0 %}
                                {%  set i = 0 %}
                                {% for l in lcommande %}
                                    {% if l.numCommande == facture_client.commande.codeCommande %}
                                        {%  set i = i + 1 %}
                                        {%  set montantHT = l.quantite * l.produit.prixVente %}
                                        {%  set montantTVA = montantHT * (l.tva/100) %}
                                        {%  set montantTTC = montantHT + montantTVA - l.remise %}


                                        {%  set montantTotalTTC = montantTotalTTC + montantTTC %}
                                        {%  set montantNet = montantTotalTTC - facture_client.remise - facture_client.avance %}
                                        <tr>
                                            <td width="10px">{{ i }}</td>
                                            <td>
                                                {% if l.produit.image == '' %}
                                                    <img src="{{asset('images/produit.jpeg')}}" width="50px" height="50px">
                                                {% else %}
                                                    <img src="{{asset('images/produits/'~ l.produit.image)}}" width="50px" height="50px">
                                                {% endif %}
                                            </td>
                                            <td>{{l.produit.libelle}}</td>
                                            <td>{{l.quantite}}</td>
                                            <td>{{l.produit.prixVente | number_format }}</td>
                                            <td>{{l.remise}}</td>
                                            <td>{{l.tva}} %</td>
                                            <td>{{ montantHT | number_format }}</td>
                                            <td class="text-right">{{ montantTTC | number_format }} GNF</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                                </tbody>
                                <tfoot>
                                <tr>
                                    <th colspan="7"></th>
                                    <th>Total Article</th>
                                   {#  <th class="text-right">{{ count }}</th>#}
                                    <th class="text-right">0</th>
                                </tr>
                                <tr>
                                    <th colspan="7"></th>
                                    <th>Frais de livraison</th>
                                    <th class="text-right">{{facture_client.commande.fraisLivraison | number_format(2)}} GNF</th>
                                </tr>
                                <tr>
                                    <th colspan="7"></th>
                                    <th>Total TTC</th>
                                    <th class="text-right">{{montantTotalTTC | number_format(2)}} GNF</th>
                                </tr>
                                <tr>
                                    <th colspan="7"></th>
                                    <th>Remise</th>
                                    <th class="text-right">{{facture_client.remise | number_format(2)}} GNF</th>
                                </tr>
                                <tr>
                                    <th colspan="7"></th>
                                    <th>Avance</th>
                                    <th class="text-right">{{facture_client.avance | number_format(2)}} GNF</th>
                                </tr>
                                {% set montantTotal = 0 %}
                                {% set montantTotal = facture_client.commande.fraisLivraison + montantTotalTTC - facture_client.avance - facture_client.remise %}
                                <tr>
                                    <th colspan="7"></th>
                                    <th>Montant Total</th>
                                    <th class="text-right">{{montantTotal | number_format(2)}} GNF</th>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
