{% extends 'base.html.twig' %}

{% block title %}CommandeFournisseur index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Compte fournisseur : {{ fournisseur.codeFournisseur }}</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            <a href="{{path('app_fournisseur_facture', {'id' : fournisseur.id })}}" class="btn btn-primary btn-sm  text-white">Facture <i class="mdi mdi-file p-1"></i></a>
                            <a href="{{path('app_fournisseur_index')}}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <table class="table table-striped mb-0">
                            <thead>
                            <tr>
                                <th colspan="8" class="text-center">Commande Fournisseur</th>
                            </tr>
                            <tr>
                                <th scope="col">N°</th>
                                <th scope="col">Numero Commande</th>
                                <th scope="col">Date Commande</th>
                                <th scope="col">Paiement Date</th>
                                <th scope="col">Paiement Mode</th>
                                <th scope="col">Expedition Mode</th>
                                <th scope="col">Etat</th>
                                <th scope="col"></th>
                            </tr>
                            </thead>
                            <tbody>
                                {% set i = 0 %}
                                {% for commande_fournisseur in commandes %}
                                    {% set i = i + 1 %}
                                    <tr>
                                        <td>{{ i }}</td>
                                        <td>{{ commande_fournisseur.numeroCommande }}</td>
                                        <td>{{ commande_fournisseur.dateCommande ? commande_fournisseur.dateCommande|date('Y-m-d') : '' }}</td>
                                        <td>{{ commande_fournisseur.paiementDate ? commande_fournisseur.paiementDate|date('Y-m-d') : '' }}</td>
                                        <td>{{ commande_fournisseur.paiementMode }}</td>
                                        <td>{{ commande_fournisseur.expeditionMode }}</td>
                                        <td>
                                            {% if commande_fournisseur.etat == true %}
                                                <span class="btn bg-success btn-sm">{{ commande_fournisseur.etat ? 'Valider' : 'Invalider' }}</span>
                                            {% else %}
                                                <span class="btn bg-danger btn-sm">{{ commande_fournisseur.etat ? 'Valider' : 'Invalider' }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <a href="{{ path('app_print_commande_fournisseur', {'id': commande_fournisseur.id}) }}" class="btn btn-info btn-sm" target="_blank">Imprimer <i class="fa fa-print p-1"></i></a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="9">La table commande est vide</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
