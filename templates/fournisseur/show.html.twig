{% extends 'base.html.twig' %}

{% block title %}Fournisseur{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Détails fournisseur : {{ fournisseur.codeFournisseur }}</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            {% if fournisseur.etat == true %}
                                <a href="{{ path('app_fournisseur_etat', {'id': fournisseur.id}) }}" class="btn  btn-danger btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Fermé <i class="mdi mdi-close"></i></a>
                            {% else %}
                                <a href="{{ path('app_fournisseur_etat', {'id': fournisseur.id}) }}" class="btn  btn-success btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Ouvert <i class="mdi mdi-close"></i></a>
                            {% endif %}
                            <a href="{{path('app_fournisseur_edit', {'id' : fournisseur.id })}}" class="btn btn-warning btn-sm  text-white">Modifier <i class="mdi mdi-pencil-box-outline"></i></a>
                            <a href="{{path('app_fournisseur_delete', {'id' : fournisseur.id })}}" class="btn btn-danger btn-sm text-white" onclick="return confirm('Voulez-vous confirmer ?')">Supprimer <i class="mdi mdi-delete"></i></a>
                            <a href="{{path('app_fournisseur_index')}}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>Societe</th>
                                    <td>{{ fournisseur.societe }}</td>
                                    <th>Email</th>
                                    <td>{{ fournisseur.email }}</td>
                                    <th>Adresse</th>
                                    <td>{{ fournisseur.adresse }}</td>
                                </tr>
                                <tr>
                                    <th>Telephone</th>
                                    <td>{{ fournisseur.telephone }}</td>
                                    <th>Pays</th>
                                    <td>{{ fournisseur.pays | country_name}}</td>
                                    <th>Ville</th>
                                    <td>{{ fournisseur.ville }}</td>
                                </tr>
                                <tr>
                                    <th>Etat</th>
                                    <td>
                                        {% if fournisseur.etat == true %}
                                            <span class="btn btn-sm text-white btn-success">{{ fournisseur.etat ? 'Activer' : 'Désactiver' }}</span>
                                        {% elseif fournisseur.etat == false %}
                                            <span class="btn btn-sm text-white btn-danger">{{ fournisseur.etat ? 'Activer' : 'Désactiver' }}</span>
                                        {% endif %}
                                    </td>
                                    <th>Nombre de Commande</th>
                                    <td><span class="btn btn-primary">{{ nombres }}</span></td>
                                    <th>Note</th>
                                    <td>{{ fournisseur.note }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
