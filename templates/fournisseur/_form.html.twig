{{ form_start(form) }}
<div class="card-header">
    <h4 class="card-title">Modifier un fournisseur</h4>
</div>
<div class="card-body">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">{{ form_row(form.code_fournisseur)}}</div>
            <div class="col-md-4">{{ form_row(form.societe)}}</div>
            <div class="col-md-4">{{ form_row(form.adresse)}}</div>
        </div>
        <div class="row">
            <div class="col-md-3">{{ form_row(form.telephone)}}</div>
            <div class="col-md-3">{{ form_row(form.email)}}</div>
            <div class="col-md-3">{{ form_row(form.pays)}}</div>
            <div class="col-md-3">{{ form_row(form.ville)}}</div>
        </div>
        <div class="row">
            <div class="col-md-12">{{ form_row(form.note)}}</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-12"><span class="text-danger">Les champs avec (*) sont obligatoires</span></div>
        </div>
    </div>
</div>

<div class="card-footer text-end">
    <div class="d-flex">
        <a href="{{path('app_fournisseur_index')}}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply p-1"></i></a>
        <button type="submit" class="btn btn-primary btn-sm ms-auto">Modifier <i class="mdi mdi-content-save p-1"></i></button>
    </div>
</div>
{{ form_end(form) }}
