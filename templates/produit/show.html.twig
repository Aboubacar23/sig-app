{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Détails produit : {{ produit.codeProduit }}</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            {% if produit.etat == 'Vente' %}
                                <a href="{{ path('app_entrepot_etat', {'id': produit.id}) }}" class="btn  btn-danger btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Fermé <i class="mdi mdi-close"></i></a>
                            {% else %}
                                <a href="{{ path('app_produit_etat', {'id': produit.id}) }}" class="btn  btn-success btn-sm m-2 text-white" onclick="confirm('Voulez-vous confirmer ?')">Ouvert <i class="mdi mdi-close"></i></a>
                            {% endif %}
                            <a href="{{path('app_produit_edit', {'id' : produit.id })}}" class="btn btn-warning btn-sm  text-white">Modifier <i class="mdi mdi-pencil-box-outline"></i></a>
                            <a href="{{path('app_produit_delete', {'id' : produit.id })}}" class="btn btn-danger btn-sm text-white" onclick="return confirm('Voulez-vous confirmer ?')">Supprimer <i class="mdi mdi-delete"></i></a>
                            <a href="{{path('app_produit_index')}}" class="btn btn-secondary btn-sm text-white">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}
                        <div class="col-md-9">
                            <table class="table">
                                <tbody>
                                <tr>
                                    <th>Code produit</th>
                                    <td>{{ produit.codeProduit }}</td>
                                    <th>Libelle</th>
                                    <td>{{ produit.libelle }}</td>
                                    <th>Reference</th>
                                    <td>{{ produit.reference }}</td>
                                    <th>Prix vente</th>
                                    <td>{{ produit.prixVente | number_format }} GNF</td>
                                </tr>
                                <tr>
                                    <th>Quantite</th>
                                    <td>
                                        {% if produit.quantite >= produit.stockInitial %}
                                            <span class="btn btn-success btn-sm text-white">{{ produit.quantite }}</span>
                                        {% else %}
                                            <span class="btn btn-danger btn-sm text-white">{{ produit.quantite }}</span>
                                        {% endif %}
                                    </td>
                                    <th>Stock initial</th>
                                    <td>
                                        <span class="btn btn-danger btn-sm text-white" style="width: 50px">{{ produit.stockInitial }}</span>
                                    </td>
                                    <th>Poids</th>
                                    <td>{{ produit.poids }}</td>
                                    <th>Volume</th>
                                    <td>{{ produit.volume }}</td>
                                </tr>
                                <tr>
                                    <th>Couleur</th>
                                    <td>{{ produit.couleur }}</td>
                                    <th>Etat</th>
                                    <td>
                                        {% if produit.etat == 'Vente' %}
                                            <span class="btn btn-success btn-sm text-white">{{ produit.etat }}</span>
                                        {% else %}
                                            <span class="btn btn-danger btn-sm text-white">{{ produit.etat }}</span>
                                        {% endif %}
                                    </td>
                                    <th>Desciption</th>
                                    <td>{{ produit.desciption }}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-3">
                            <td>
                                {% if produit.image == '' %}
                                    <img src="{{asset('images/produit.jpeg')}}" width="300" height="300" class="rounded-circle">
                                {% else %}
                                    <img src="{{asset('images/produits/'~ produit.image)}}" width="300" height="300" class="rounded-circle">
                                {% endif %}
                            </td>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
