{% extends 'base.html.twig' %}

{% block title %}Produit index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">

                                <div class="row">
                                    <div class="col-md-3">
                                        <h4 class="card-title">Liste des produits</h4>
                                    </div>
                                    <div class="col-md-9 text-end">
                                        <a href="{{ path('app_produit_new') }}" class="btn btn-primary btn-sm">Ajouter <i class="mdi mdi-plus-box p-1"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                {% for message in app.flashes('error') %}
                                    <div class="alert alert-danger">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true">
                                    <table id="dataTable" class="table table-striped mb-0"  style="width:100%">
                                        <thead>
                                        <tr>
                                            <th width="2">N°</th>
                                            <th>Image</th>
                                            <th>Code produit</th>
                                            <th>Libelle</th>
                                            <th>Quantité</th>
                                            <th>Prix (GNF)</th>
                                            <th>Stock Initial</th>
                                            <th>Etat Produit</th>
                                            <th class="text-center" width="100"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set i = 0 %}
                                        {% set totalPrixA  = 0 %}
                                        {% set totalPrixV = 0 %}
                                        {% for produit in produits %}
                                            {% set i = i + 1 %}
                                            {% set totalPrixA  = totalPrixA + produit.prixAchat %}
                                            {% set totalPrixV = totalPrixV + produit.prixVente %}
                                            <tr>
                                                <td>{{ i }}</td>
                                                <td>
                                                    {% if produit.image == '' %}
                                                        <img src="{{asset('images/images/product.jpg')}}" width="60" width="60" class="rounded-circle border-2">
                                                    {% else %}
                                                        <img src="{{asset('images/produits/'~ produit.image)}}" width="60" width="60" class="rounded-circle border-2">
                                                    {% endif %}
                                                </td>
                                                <td>{{ produit.codeProduit }}</td>
                                                <td>{{ produit.libelle }}</td>
                                                <td>
                                                    {% if produit.quantite >= produit.stockInitial %}
                                                        <span class="btn btn-success btn-sm text-white text-center" style="width: 50px">{{ produit.quantite }}</span>
                                                    {% else %}
                                                        <span class="btn btn-danger btn-sm text-white text-center" style="width: 50px">{{ produit.quantite }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>{{ produit.prixVente | number_format}} GNF</td>
                                                <td>
                                                    <span class="btn btn-danger btn-sm text-white" style="width: 50px">{{ produit.stockInitial }}</span>
                                                </td>
                                                <td>
                                                    {% if produit.etat == 'Vente' %}
                                                        <span class="btn btn-success btn-sm text-white" style="width: 100px">{{ produit.etat }}</span>
                                                    {% else %}
                                                        <span class="btn btn-danger btn-sm text-white" style="width: 100px">{{ produit.etat }}</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    <a class="btn-sm btn btn-success text-white btn-sm" href="{{path('app_produit_show', {'id' : produit.id})}}">Détails <i class="mdi mdi-eye"></i></a>
                                                    <a class="btn-sm btn btn-primary btn-sm text-white" href="{{path('app_produit_edit', {'id' : produit.id})}}">Modifier <i class="mdi mdi-check"></i></a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
