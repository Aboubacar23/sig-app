{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}

{% if nombres == null %}
    {% set val = 1 %}
{% else %}
    {% set val = nombres + 1 %}
{% endif %}

{% set dateJour = "now"|date("Ym") %}
{% set numProduit = 'PRO'~dateJour~'-'~val %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                {{ form_start(form) }}
                <div class="card-header">
                    <h4 class="card-title">Ajouter un produit</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.code_produit, { attr : { value: numProduit }})}}</div>
                        <div class="col-md-3">{{ form_row(form.fournisseur)}}</div>
                        <div class="col-md-3">{{ form_row(form.libelle)}}</div>
                        <div class="col-md-3">{{ form_row(form.reference)}}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.quantite)}}</div>
                        <div class="col-md-3">{{ form_row(form.stock_initial)}}</div>
                        <div class="col-md-3">{{ form_row(form.prix_vente)}}</div>
                        <div class="col-md-3">{{ form_row(form.etat)}}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">{{ form_row(form.entrepot)}}</div>
                        <div class="col-md-3">{{ form_row(form.poids)}}</div>
                        <div class="col-md-3">{{ form_row(form.volume)}}</div>
                        <div class="col-md-3">{{ form_row(form.image)}}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">{{ form_row(form.desciption)}}</div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <div class="d-flex">
                        <button type="submit" class="btn btn-primary btn-sm ">Enregistre <i class="mdi mdi-content-save p-1"></i></button>
                        <a href="{{path('app_produit_index')}}" class="btn btn-secondary btn-sm ms-auto text-white">Retour <i class="mdi mdi-reply"></i></a>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
