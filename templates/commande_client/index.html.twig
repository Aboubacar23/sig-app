{% extends 'base.html.twig' %}

{% block title %}CommandeClient index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">

                                <div class="row">
                                    <div class="col-md-3">
                                        <h4 class="card-title">Liste des commandes non valider</h4>
                                    </div>
                                    <div class="col-md-9 text-end">
                                        <a href="{{ path('app_commande_client_liste') }}" class="btn btn-success btn-sm text-white">Commandes Valider <i class="mdi mdi-file p-1"></i></a>
                                        <a href="{{ path('app_commande_client_new') }}" class="btn btn-primary btn-sm">Ajouter <i class="mdi mdi-plus-box p-1"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true">
                                    <table class="table table-striped mb-0" id="dataTable">
                                        <thead>
                                        <tr>
                                            <th scope="col">N°</th>
                                            <th>Code commande</th>
                                            <th>Numero reference</th>
                                            <th>Client</th>
                                            <th>Date commande</th>
                                            <th>Type commande</th>
                                            <th>Etat Commande</th>
                                            <th class="text-center" width="200"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set i = 0 %}
                                        {% for commande_client in commande_clients %}
                                            {% set i = i + 1 %}
                                            <tr>
                                                <td>{{ i }}</td>
                                                <td>{{ commande_client.codeCommande }}</td>
                                                <td>{{ commande_client.numeroReference }}</td>
                                                <td>{{ commande_client.client.nom }} {{ commande_client.client.prenom }}</td>
                                                <td>{{ commande_client.dateCommande ? commande_client.dateCommande|date('Y-m-d') : '' }}</td>
                                                <td>{{ commande_client.typeCommande }}</td>
                                                <td>
                                                    {% if commande_client.etat == true %}
                                                        <span class="btn bg-success btn-sm text-white">{{ commande_client.etat ? 'Valider' : 'Non Valider' }}</span>
                                                    {% else %}
                                                        <span class="btn bg-danger btn-sm text-white">{{ commande_client.etat ? 'Valider' : 'Non Valider' }}</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    <a href="{{ path('app_commande_client_show', {'id': commande_client.id}) }}" class="btn btn-info text-white btn-sm">Détails <i class="mdi mdi-eye p-1"></i></a>
                                                    <a href="{{ path('app_commande_client_edit', {'id': commande_client.id}) }}" class="btn btn-primary text-white btn-sm">Modifier<i class="mdi mdi-pencil-box-outline p-1"></i></a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
