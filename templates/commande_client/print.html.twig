{% extends 'base_print.html.twig' %}

{% block title %}CommandeClient index{% endblock %}

{% block body %}
    <header class="clearfix">
        <div id="logo">
            <img src="{{ absolute_url(asset('images/images/logo.jpeg')) }}" >
        </div>

        {% if commande_client.etat == true %}
            <h1>Bon de Commande</h1>
        {% else %}
            <h1>Devis</h1>
        {% endif %}
        <div id="company" class="clearfix">
            <div>Sacko Investment Group - SARL</div>
            <div>Dixinn face a la commune immeuble dem 4 em étage
                ,<br /> Conakry République de Guinée</div>
            <div>+224 628 44 67 40</div>
            <div><a href="#">Sackomory547@gmail.com</a></div>
        </div>
        <div id="project">
            <div><span>N° Commande : </span> <small>{{ commande_client.codeCommande }}</small></div>
            <div><span>N°  Réference :</span> <small>{{ commande_client.numeroReference }}</small></div>
            <div><span>Date Commande :</span> <small>{{ commande_client.dateCommande ? commande_client.dateCommande|date('d-m-Y') : '' }}</small></div>
            <div>
                <span>Etat :</span> <small>
                    {% if commande_client.etat == true %}
                        {{ commande_client.etat ? 'Valider' : 'Non Valider' }}
                    {% else %}
                        {{ commande_client.etat ? 'Valider' : 'Non Valider' }}
                    {% endif %}
                </small>
            </div>
            <div><span>Type Commande :</span> <small>{{ commande_client.typeCommande }}</small></div>
        </div>
    </header>
    <hr>
    <header class="clearfix">
        <div id="company" class="clearfix">
            <div><span>Date Réception : </span> <small>{{ commande_client.receptionDate ? commande_client.receptionDate|date('d-m-Y') : '' }}</small></div>
            <div><span>Date Paiement : </span> <small>{{ commande_client.paiementDate ? commande_client.paiementDate|date('d-m-Y') : '' }}</small></div>
            <div><span>Date Impression : </span> <small>{{ "now"|date("d-m-Y") }}</small></div>
        </div>
        <div id="project">
            <div><span>Client : </span> <small>{{ commande_client.client.nom }} {{ commande_client.client.prenom }}</small></div>
            <div><span>Tél :</span> <small>{{ commande_client.client.telephone }}</small></div>
            <div><span>Email :</span> <small>{{ commande_client.client.email }}</small></div>
            <div><span>Adresse :</span> <small>{{ commande_client.client.adresse }}</small></div>
        </div>
    </header>
    <hr>
    <main>
        <table>
            <thead>
            <tr>
                <th class="service" colspan="10"></th>
            </tr>
            <tr>
                <th style="width: 5px!important;">N°</th>
                <th style="width: 70px!important;">Produit</th>
                <th style="width: 50px!important;">Qte</th>
                <th class="tab_prix">Prix Unitaire (GNF)</th>
                <th class="tab_prix">Remise (GNF)</th>
                <th class="tab_q">TVA (%)</th>
                <th class="tab_prix" style="text-align: left!important;">Total HT (GNF)</th>
                <th class="tab_prix" style="text-align: right!important;">Total TTC (GNF)</th>
            </tr>
            </thead>
            <tbody>
            {%  set montantTotalTTC = 0 %}
            {%  set montantTotalHT = 0 %}
            {%  set montantHT = 0 %}
            {%  set montantTTC = 0 %}
            {%  set montantTVA = 0 %}
            {%  set i = 0 %}
            {%  set count = 0 %}

            {% for l in lcommandes %}
                {% if l.numCommande == commande_client.codeCommande %}
                    {%  set i = i + 1 %}
                    {%  set count = count + 1 %}
                    {%  set montantHT = l.quantite * l.produit.prixVente %}
                    {%  set montantTVA = montantHT * (l.tva/100) %}
                    {%  set montantTTC = montantHT + montantTVA - l.remise %}
                    {%  set montantTotalTTC = montantTotalTTC + montantTTC %}
                    {%  set montantTotalHT = montantTotalHT + montantHT %}

                    <tr class="th">
                        <td width="10px">{{ i }}</td>
                        <td>{{l.produit.libelle}}</td>
                        <td class="tab_right">{{l.quantite}}</td>
                        <td class="tab_right">{{l.produit.prixVente | number_format(2) }} GNF</td>
                        <td class="tab_right">{{l.remise}}</td>
                        <td class="tab_right">{{l.tva}} %</td>
                        <td class="tab_right" style="text-align: left!important;">{{ montantHT | number_format(2) }} GNF</td>
                        <td class="tab_right" style="text-align: right!important;">{{ montantTTC | number_format(2) }} GNF</td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
            <tfoot class="table-secondary">
                <tr>
                    <th colspan="6"></th>
                    <th>Total Produit</th>
                    <th class="text-right" style="text-align: right!important;">{{ count }}</th>
                </tr>
                <tr>
                    <th colspan="6"></th>
                    <th>Frais de livraison</th>
                    <th class="text-right" style="text-align: right!important;">{{commande_client.fraisLivraison | number_format(2)}} GNF</th>
                </tr>
                <tr>
                    <th colspan="6"></th>
                    <th>Total TTC</th>
                    <th class="text-right" style="text-align: right!important;">{{montantTotalTTC | number_format(2)}} GNF</th>
                </tr>
                {% set montantTotal = 0 %}
                {% set montantTotal = commande_client.fraisLivraison + montantTotalTTC  %}
                <tr>
                    <th colspan="6"></th>
                    <th>Montant Total</th>
                    <th class="text-right" style="text-align: right!important;">{{montantTotal | number_format(2)}} GNF</th>
                </tr>
            </tfoot>
        </table>
        <div id="notices">
            {# {% set montant = montant1 - montant2 %}
            <div class="notice">Solde: {{ montant | number_format }} GNF </div>
            <hr>
            <div class="grand_total" style="text-transform: uppercase">Montant en lettre : <span style="font-size: 12px">{{ lettre }}</span></div> #}
        </div>
    </main>
    <footer>
        Cet bon est valable qu'avec signature ou cachet
    </footer>
{% endblock %}
