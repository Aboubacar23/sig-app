{% extends 'base.html.twig' %}

{% block title %}New CommandeClient{% endblock %}

{% block body %}

{% if dernier == null %}
    {% set val = 1 %}
{% else %}
    {% set val = dernier.id + 1 %}
{% endif %}
{% set dateJour = "now"|date("Ym") %}
{% set numFour = 'CCC'~dateJour~val %}

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <form method="post">
                    <div class="card-header">
                        <h4 class="card-title">Ajouter une commande</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-md-3">{{ form_row(form.code_commande , { attr : { value: numFour }})}}</div>
                            <div class="col-md-3">{{ form_row(form.client)}}</div>
                            <div class="col-md-3">{{ form_row(form.date_commande)}}</div>
                            <div class="col-md-3">{{ form_row(form.numero_reference)}}</div>
                            <div class="col-md-3">{{ form_row(form.reception_date)}}</div>
                            <div class="col-md-3">{{ form_row(form.paiement_date)}}</div>
                            <div class="col-md-3">{{ form_row(form.frais_livraison)}}</div>
                        </div>
                        <!-- le formulaire d commandee produit -->
                        <div class="row mb-2">
                            <table class="table table-striped mb-0 table-sm">
                                <thead>
                                    <tr>
                                        <td>Produit</td>
                                        <td>Qte</td>
                                        <td>Remise (GNF)</td>
                                        <td>TVA %</td>
                                        <td class="text-center" width="50"></td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>{{ form_widget(f.produit)}}</td>
                                        <td>{{ form_widget(f.quantite)}}</td>
                                        <td>{{ form_widget(f.remise)}}</td>
                                        <td>{{ form_widget(f.tva)}}</td>
                                        <td><input type="submit" value="Ajouter" name="bt" class="btn btn-primary btn-sm p-2 text-white"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="row mb-2">
                            <table class="table table-striped mb-0 table-sm">
                                <thead>
                                    <tr>
                                        <td>N°</td>
                                        <td>Images</td>
                                        <td>Produit</td>
                                        <td>Qte</td>
                                        <td>Prix Unitaire</td>
                                        <td>TVA %</td>
                                        <td>Remise</td>
                                        <td>Montant HT</td>
                                        <td>Montant TTC</td>
                                        <td width="50;"></td>
                                    </tr>
                                </thead>
                                <tbody>
                                {%  set montantTotalHT = 0 %}
                                {%  set montantTotalTTC = 0 %}
                                {%  set montantTVA = 0 %}
                                {%  set montantTTC = 0 %}
                                {%  set montantHT = 0 %}
                                {%  set i = 0 %}

                                {% for l in lcom %}

                                    {%  set i = i + 1 %}
                                    {%  set montantHT = l.quantite * l.produit.prixVente %}

                                    {%  set montantTVA = montantHT * (l.tva/100) %}

                                    {%  set montantTTC = montantHT + montantTVA - l.remise %}

                                    {%  set montantTotalHT = montantTotalHT + montantTTC %}
                                    {%  set montantTotalTTC = montantTotalTTC + montantTTC %}
                                    <tr>
                                        <td width="10px">{{ i }}</td>
                                        <td>
                                            {% if l.produit.image == '' %}
                                                <img src="{{asset('images/produit.jpeg')}}" width="50px" height="50px">
                                            {% else %}
                                                <img src="{{asset('images/produits/'~ l.produit.image)}}" width="50px" height="50px">
                                            {% endif %}
                                        </td>
                                        <td>{{l.produit.libelle}}</td>
                                        <td>{{l.quantite}}</td>
                                        <td>{{l.produit.prixVente | number_format }}</td>
                                        <td>{{l.tva}}</td>
                                        <td>{{ l.remise | number_format }}</td>
                                        <td>{{ montantHT | number_format }}</td>
                                        <td>{{ montantTTC | number_format }}</td>
                                        <td>
                                            <a class="btn btn-danger btn-sm p-1" href="{{path('delete', { 'id': l.lig})}}"><i class="mdi mdi-delete"></i></a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                                <tfoot>
                                <tr>
                                    <th colspan="7"></th>
                                    <th>{{montantTotalHT | number_format}}</th>
                                    <th>{{montantTotalTTC | number_format}}</th>
                                    <th></th>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <div class="d-flex">
                            <button type="submit" class="btn btn-primary btn-sm" name="bt" value="Valider">Enregistre <i class="mdi mdi-content-save p-1"></i></button>
                            <a href="{{path('app_commande_client_index')}}" class="btn btn-secondary btn-sm ms-auto text-white">Retour <i class="mdi mdi-reply"></i></a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        function updateSumField()
        {
            let qte = parseFloat(document.getElementById('l_commande_client_quantite').value);
            //let prix = parseFloat(document.getElementById('l_suivi_client_vehicule_qte').value);
            let taux_tva = parseFloat(document.getElementById('l_commande_client_tva').value);

            tva = (taux_tva /100);
            console.log(tva);

            var total_ht = document.getElementById('total_ht');
            var total_htt = document.getElementById('total_htt');

           // mt = qte * prix;
            //result1.value= isNaN(mt) ? '' : (mt);
        }
        document.getElementById('total_ht').addEventListener('input', updateSumField);
        document.getElementById('total_htt').addEventListener('input', updateSumField);
        document.getElementById('l_commande_client_tva').addEventListener('input', updateSumField);
    });
</script>
{% endblock %}
