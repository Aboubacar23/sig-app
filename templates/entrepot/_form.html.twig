{{ form_start(form) }}
<div class="card-header">
    <h4 class="card-title">Ajouter entrepot</h4>
</div>
<div class="card-body">
    <div class="row mb-2">
        <div class="col-md-4">{{ form_row(form.libelle)}}</div>
        <div class="col-md-4">{{ form_row(form.adresse)}}</div>
        <div class="col-md-4">{{ form_row(form.telephone)}}</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-6">{{ form_row(form.pays)}}</div>
        <div class="col-md-6">{{ form_row(form.ville)}}</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-2 m-10">{{ form_row(form.etat)}}</div>
    </div>
    <div class="row mb-2">
        <div class="col-md-12">{{ form_row(form.description)}}</div>
    </div>
</div>
<div class="card-footer text-end">
    <div class="d-flex">
        <button type="submit" class="btn btn-primary btn-sm "><i class="mdi mdi-content-save icon-table"></i></button>
        <a href="{{path('app_entrepot_index')}}" class="btn btn-secondary btn-sm ms-auto text-white"><i class="mdi mdi-reply icon-table"></i></a>
    </div>
</div>   
{{ form_end(form) }}
