{% extends 'base.html.twig' %}

{% block title %}Entrepot index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">

                                <div class="row">
                                    <div class="col-md-3">
                                        <h4 class="card-title">Liste des entrepôts</h4>
                                    </div>
                                    <div class="col-md-9 text-end">
                                        {# <a href="#" class="btn btn-secondary text-white">Nombres : {{ entrepots | length}}</a>
                                        <a href="{{path('app_entrepot_new')}}" class="btn btn-primary btn-sm"><i class="mdi mdi-plus-circle icon-table"></i></a>#}
                                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                            <i class="mdi mdi-plus-box icon-table"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true">
                                    <table class="table table-striped mb-0">
                                        <thead>
                                        <tr>
                                            <th scope="col">N°</th>
                                            <th scope="col">Libelle</th>
                                            <th scope="col">Pays</th>
                                            <th scope="col">Ville</th>
                                            <th scope="col">Adresse</th>
                                            <th scope="col">Telephone</th>
                                            <th scope="col">Total Produit</th>
                                            <th scope="col">Etat</th>
                                            <th class="text-center" width="250">Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set i = 0 %}
                                        {% for entrepot in entrepots %}
                                            {% set i = i + 1 %}
                                            {% set toatlProduit = 0 %}
                                            {% for produit in produits %}
                                                {% if entrepot.id == produit.entrepot.id %}
                                                    {% set toatlProduit = toatlProduit + produit.quantite %}
                                                {% endif %}
                                            {% endfor %}
                                            <tr>
                                                <td>{{ i }}</td>
                                                <td>{{ entrepot.libelle }}</td>
                                                <td>{{ entrepot.pays | country_name }}</td>
                                                <td>{{ entrepot.ville }}</td>
                                                <td>{{ entrepot.adresse }}</td>
                                                <td>{{ entrepot.telephone }}</td>
                                                <td class="text-center"><span class="btn btn-warning btn-sm text-white">{{ toatlProduit | number_format }}</span></td>
                                                <td>
                                                    {% if entrepot.etat == true %}
                                                        <span class="btn bg-success btn-sm text-white">{{ entrepot.etat ? 'Ouvert' : 'Fermé' }}</span>
                                                    {% else %}
                                                        <span class="btn bg-danger btn-sm text-white">{{ entrepot.etat ? 'Ouvert' : 'Fermé' }}</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    <a href="{{ path('app_entrepot_show', {'id': entrepot.id}) }}" class="btn btn-info  btn-sm"><i class="mdi mdi-eye p-2 text-white"></i></a>
                                                    <a href="{{ path('app_entrepot_edit', {'id': entrepot.id}) }}" class="btn btn-primary  btn-sm"><i class="mdi mdi-pencil-box-outline p-2 text-white"></i></a>
                                                    <a href="{{ path('app_entrepot_produit', {'id': entrepot.id}) }}" class="btn btn-success  btn-sm"><i class="mdi mdi-archive p-2 text-white"></i></a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Ajouter</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            {{ form_start(form) }}
                <div class="modal-body">
                    <div class="row mb-4">
                        <div class="col-md-12">{{ form_row(form.libelle) }}</div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">{{ form_row(form.pays) }}</div>
                        <div class="col-md-6">{{ form_row(form.ville) }}</div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">{{ form_row(form.adresse) }}</div>
                        <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-12">{{ form_row(form.description) }}</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary text-white" data-bs-dismiss="modal"><i class="mdi mdi-close"></i></button>
                    <button type="submit" class="btn btn-primary"><i class="mdi mdi-content-save"></i></button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

{% endblock %}
