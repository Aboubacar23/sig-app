{% extends 'base.html.twig' %}

{% block title %}Produit index{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">

                                <div class="row">
                                    <div class="col-md-3">
                                        <h4 class="card-title">Approvisionnement</h4>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                <div class="table-responsive table-scroll" data-mdb-perfect-scrollbar="true">
                                    <table class="table table-striped mb-0">
                                        <thead>
                                        <tr>
                                            <th>N°</th>
                                            <th>Image</th>
                                            <th>Code produit</th>
                                            <th>Libelle</th>
                                            <th>Quantité</th>
                                            <th>Stock Initial</th>
                                            <th class="text-center" width="250"></th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set i = 0 %}
                                        {% set totalPrixA  = 0 %}
                                        {% set totalPrixV = 0 %}
                                        {% for produit in produits %}
                                            {% set i = i + 1 %}
                                            {% set totalPrixA  = totalPrixA + produit.prixAchat %}
                                            {% set totalPrixV = totalPrixV + produit.prixVente %}
                                            <tr>
                                                <td>{{ i }}</td>
                                                <td>
                                                    {% if produit.image == '' %}
                                                        <img src="{{asset('images/images/product.jpg')}}" width="100" width="100" class="rounded-circle border-2">
                                                    {% else %}
                                                        <img src="{{asset('images/produits/'~ produit.image)}}" width="100" width="100" class="rounded-circle border-2">
                                                    {% endif %}
                                                </td>
                                                <td>{{ produit.codeProduit }}</td>
                                                <td>{{ produit.libelle }}</td>
                                                <td>
                                                    {% if produit.quantite >= produit.stockInitial %}
                                                        <span class="btn btn-success btn-sm text-white text-center" style="width: 50px">{{ produit.quantite }}</span>
                                                    {% else %}
                                                        <span class="btn btn-danger btn-sm text-white text-center" style="width: 50px">{{ produit.quantite }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <span class="btn btn-danger btn-sm text-white" style="width: 50px">{{ produit.stockInitial }}</span>
                                                </td>
                                                <td class="text-center">
                                                    <a href="{{path('app_approvisionnement_edit', {'id': produit.id})}}" class="btn btn-primary btn-sm"><i class="mdi mdi-plus-box p-1"></i></a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="16">La table est vide </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
