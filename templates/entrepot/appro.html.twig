{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h4 class="card-title">Approvisionnement</h4>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <a href="{{ path('app_approvision') }}" class="btn btn-secondary text-white btn-sm">Retour <i class="mdi mdi-reply p-1"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                                    {{ form_start(form) }}
                                    <div class="row mb-2">
                                        <table id="dataTable" class="table table-striped mb-0 table-responsive"  style="width:100%">
                                            <thead>
                                                <tr>
                                                    <td>Produit</td>
                                                    <td>Code Produit</td>
                                                    <td>Libele</td>
                                                    <td>Quantité</td>
                                                    <td>Nouvelle Quantité</td>
                                                    <td class="text-center" width="100"></td>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            <tr>
                                                <td>
                                                    {% if produit.image == '' %}
                                                        <img src="{{asset('images/images/produit.jpeg')}}" width="40px" height="40px">
                                                    {% else %}
                                                        <img src="{{asset('images/produits/'~ produit.image)}}" width="40px" height="40px">
                                                    {% endif %}
                                                </td>
                                                <td>{{ produit.codeProduit}}</td>
                                                <td>{{ produit.libelle}}</td>
                                                <td>
                                                    {% if produit.quantite >= produit.stockInitial %}
                                                        <span class="btn btn-success btn-sm">{{ produit.quantite }}</span>
                                                    {% else %}
                                                        <span class="btn btn-danger btn-sm">{{ produit.quantite }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>{{ form_widget(form.quantite, { 'attr' : { value: 0}})}}</td>
                                                <td><button class="btn btn-primary btn-sm" onclick="confirm('Voulez-vous confirmer ?')">{{ button_label|default('Re-Approvisionné') }} <i class="mdi mdi-plus p-1"></i></button></td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
