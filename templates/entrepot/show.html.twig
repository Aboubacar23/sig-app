{% extends 'base.html.twig' %}

{% block title %}Entrepot{% endblock %}

{% block body %}

{% set toatlProduit = 0 %}
{% for produit in produits %}
    {% if entrepot.id == produit.entrepot.id %}
        {% set toatlProduit = toatlProduit + produit.quantite %}
    {% endif %}
{% endfor %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4 class="card-title">Détails Camion</h4>
                        </div>
                        <div class="col-md-9 text-end">
                            {% if entrepot.etat == true %}
                                <a href="{{ path('app_entrepot_etat', {'id': entrepot.id}) }}" class="btn  btn-danger btn-sm" onclick="confirm('Voulez-vous confirmer ?')">Fermé</a>
                            {% else %}
                                <a href="{{ path('app_entrepot_etat', {'id': entrepot.id}) }}" class="btn  btn-success btn-sm" onclick="confirm('Voulez-vous confirmer ?')">Ouvert</a>
                            {% endif %}
                            <a href="{{path('app_entrepot_edit', {'id' : entrepot.id })}}" class="btn btn-warning btn-sm  text-white">Modifier <i class="mdi mdi-pencil-box-outline icon-table"></i></a>
                            <a href="{{path('app_entrepot_delete', {'id' : entrepot.id })}}" class="btn btn-danger btn-sm m-2 text-white" onclick="return confirm('Voulez-vous confirmer ?')">Supprimer <i class="mdi mdi-delete icon-table"></i></a>
                            <a href="{{path('app_entrepot_index')}}" class="btn btn-secondary btn-sm  ms-auto text-white">Retour <i class="mdi mdi-reply icon-table"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <table class="table">
                            <tbody>
                            <tr>
                                <th>Libelle</th>
                                <td>{{ entrepot.libelle }}</td>
                                <th>Total</th>
                                <td><span class="btn btn-warning btn-sm">{{ toatlProduit | number_format }}</span></td>
                            </tr>
                            <tr>
                                <th>Pays</th>
                                <td>{{ entrepot.pays }}</td>
                                <th>Ville</th>
                                <td>{{ entrepot.ville }}</td>
                            </tr>
                            <tr>
                                <th>Adresse</th>
                                <td>{{ entrepot.adresse }}</td>
                                <th>Telephone</th>
                                <td>{{ entrepot.telephone }}</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ entrepot.description }}</td>
                                <th>Etat</th>
                                <td>
                                    {% if entrepot.etat == true %}
                                        <span class="btn bg-success btn-sm">{{ entrepot.etat ? 'Ouvert' : 'Fermé' }}</span>
                                    {% else %}
                                        <span class="btn bg-danger btn-sm">{{ entrepot.etat ? 'Ouvert' : 'Fermé' }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                    <hr>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
